(= (hide $value) (empty))

(= (first-sorted-property $concept)
   (let (cons $first $rest) (msort $concept) $first))

(= (source-historical-blends)
   (collapse (match &self ($a $b $c) ($a $b $c))))

(= (append-all-blends ())
   ())
(= (append-all-blends (cons $blend $remaining-blends))
   (if (is-expr $blend)
       (append $blend (append-all-blends $remaining-blends))
       (append-all-blends $remaining-blends)))

(= (memory-properties)
   (unique-atom (append-all-blends (source-historical-blends))))

(= (generated-core-blend $concept-1 $concept-2)
   (unique-atom ((first-sorted-property $concept-1)
                 (first-sorted-property $concept-2))))

(= (candidate-extension $core-blend $core-property $historical-property)
   (if (and (not (is-member $historical-property $core-blend))
            (>= (get-habit-strength $core-property $historical-property) 0.5))
       ($historical-property)
       ()))

(= (discover-extensions-for-property $core-blend $core-property ())
   ())
(= (discover-extensions-for-property $core-blend $core-property (cons $historical-property $remaining-properties))
   (append
      (candidate-extension $core-blend $core-property $historical-property)
      (discover-extensions-for-property $core-blend $core-property $remaining-properties)))

(= (discover-extensions-from-core $core-blend ())
   ())
(= (discover-extensions-from-core $core-blend (cons $core-property $remaining-core))
   (append
      (discover-extensions-for-property $core-blend $core-property (memory-properties))
      (discover-extensions-from-core $core-blend $remaining-core)))

(= (discover-extensions $core-blend)
   (unique-atom (discover-extensions-from-core $core-blend $core-blend)))

(= (print-discovered-extension $core-blend $core-property $historical-property)
   (let $habit-link (get-habit-strength $core-property $historical-property)
        (if (and (not (is-member $historical-property $core-blend))
                 (>= $habit-link 0.5))
            (println! (Colimit Discovery: $historical-property linked-to $core-property M_P = $habit-link))
            ())))

(= (print-discovered-extensions-for-property $core-blend $core-property ())
   ())
(= (print-discovered-extensions-for-property $core-blend $core-property (cons $historical-property $remaining-properties))
   (let* (($print-one (print-discovered-extension $core-blend $core-property $historical-property))
          ($print-rest (print-discovered-extensions-for-property $core-blend $core-property $remaining-properties)))
      ()))

(= (print-discovered-extensions-from-core $core-blend ())
   ())
(= (print-discovered-extensions-from-core $core-blend (cons $core-property $remaining-core))
   (let* (($print-one-row (print-discovered-extensions-for-property $core-blend $core-property (memory-properties)))
          ($print-rest (print-discovered-extensions-from-core $core-blend $remaining-core)))
      ()))

(= (sum-habit-strength-to-rest $property ())
   0.0)
(= (sum-habit-strength-to-rest $property (cons $next-property $remaining-properties))
   (+ (get-habit-strength $property $next-property)
      (sum-habit-strength-to-rest $property $remaining-properties)))

(= (calculate-blend-habit-bonus-from-list ())
   0.0)
(= (calculate-blend-habit-bonus-from-list (cons $property $remaining-properties))
   (+ (sum-habit-strength-to-rest $property $remaining-properties)
      (calculate-blend-habit-bonus-from-list $remaining-properties)))

(= (calculate-blend-habit-bonus $candidate-properties)
   (calculate-blend-habit-bonus-from-list $candidate-properties))

(= (candidate-generation-result $concept-1 $concept-2)
   (let* (($core-blend (generated-core-blend $concept-1 $concept-2))
          ($extensions (discover-extensions $core-blend))
          ($candidate-1 $core-blend)
          ($candidate-2 (unique-atom (append $core-blend $extensions)))
          ($bonus-1 (calculate-blend-habit-bonus $candidate-1))
          ($bonus-2 (calculate-blend-habit-bonus $candidate-2)))
      (candidate-result $candidate-1 $bonus-1 $candidate-2 $bonus-2)))

(= (generate-and-evaluate-candidates $concept-1 $concept-2)
   (let* (($step-4 (println! (--- STEP 4: Algorithmic Candidate Generation & Evaluation ---)))
          ($core-blend (generated-core-blend $concept-1 $concept-2))
          ($show-core (println! (Search Engine: Automatically selected core pairing: $core-blend)))
          ($print-extensions (print-discovered-extensions-from-core $core-blend $core-blend))
          ($extensions (discover-extensions $core-blend))
          ($candidate-1 $core-blend)
          ($candidate-2 (unique-atom (append $core-blend $extensions)))
          ($bonus-1 (calculate-blend-habit-bonus $candidate-1))
          ($bonus-2 (calculate-blend-habit-bonus $candidate-2))
          ($eval-title (println! (Evaluating Generated Options:)))
          ($eval-1 (println! (Candidate 1 Basic Core $candidate-1 Habit Bonus: $bonus-1)))
          ($eval-2 (println! (Candidate 2 Expanded $candidate-2 Habit Bonus: $bonus-2))))
      (candidate-result $candidate-1 $bonus-1 $candidate-2 $bonus-2)))
