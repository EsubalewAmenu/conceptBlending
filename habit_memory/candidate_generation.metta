; Step 4 orchestration: candidate generation and habit-bonus evaluation.

(= (first-sorted-property $concept)
   (let (cons $first $rest) (msort $concept) $first))

(= (generated-core-blend $concept-1 $concept-2)
   (unique-atom ((first-sorted-property $concept-1)
                 (first-sorted-property $concept-2))))

(= (candidate-extension $memory $core-blend $core-property $historical-property)
   (if (and (not (is-member $historical-property $core-blend))
            (>= (get-habit-strength $memory $core-property $historical-property) 0.5))
       ($historical-property)
       ()))

(= (discover-extensions-for-property $memory $core-blend $core-property ())
   ())
(= (discover-extensions-for-property $memory $core-blend $core-property (cons $historical-property $remaining-properties))
   (append
      (candidate-extension $memory $core-blend $core-property $historical-property)
      (discover-extensions-for-property $memory $core-blend $core-property $remaining-properties)))

(= (discover-extensions-from-core $memory $core-blend ())
   ())
(= (discover-extensions-from-core $memory $core-blend (cons $core-property $remaining-core))
   (append
      (discover-extensions-for-property $memory $core-blend $core-property (memory-properties $memory))
      (discover-extensions-from-core $memory $core-blend $remaining-core)))

(= (discover-extensions $memory $core-blend)
   (unique-atom (discover-extensions-from-core $memory $core-blend $core-blend)))

(= (print-discovered-extension $memory $core-blend $core-property $historical-property)
   (let $habit-link (get-habit-strength $memory $core-property $historical-property)
        (if (and (not (is-member $historical-property $core-blend))
                 (>= $habit-link 0.5))
            (println! (Colimit Discovery: $historical-property linked-to $core-property M_P = $habit-link))
            ())))

(= (print-discovered-extensions-for-property $memory $core-blend $core-property ())
   ())
(= (print-discovered-extensions-for-property $memory $core-blend $core-property (cons $historical-property $remaining-properties))
   (let* (($print-one (print-discovered-extension $memory $core-blend $core-property $historical-property))
          ($print-rest (print-discovered-extensions-for-property $memory $core-blend $core-property $remaining-properties)))
      ()))

(= (print-discovered-extensions-from-core $memory $core-blend ())
   ())
(= (print-discovered-extensions-from-core $memory $core-blend (cons $core-property $remaining-core))
   (let* (($print-one-row (print-discovered-extensions-for-property $memory $core-blend $core-property (memory-properties $memory)))
          ($print-rest (print-discovered-extensions-from-core $memory $core-blend $remaining-core)))
      ()))

(= (candidate-generation-result $memory $concept-1 $concept-2)
   (let* (($core-blend (generated-core-blend $concept-1 $concept-2))
          ($extensions (discover-extensions $memory $core-blend))
          ($candidate-1 $core-blend)
          ($candidate-2 (unique-atom (append $core-blend $extensions)))
          ($bonus-1 (habit-bonus $memory $candidate-1))
          ($bonus-2 (habit-bonus $memory $candidate-2)))
      (candidate-result $candidate-1 $bonus-1 $candidate-2 $bonus-2)))

(= (generate-and-evaluate-candidates $memory $concept-1 $concept-2)
   (let* (($step-4 (println! (--- STEP 4: Algorithmic Candidate Generation & Evaluation ---)))
          ($core-blend (generated-core-blend $concept-1 $concept-2))
          ($show-core (println! (Search Engine: Automatically selected core pairing: $core-blend)))
          ($print-extensions (print-discovered-extensions-from-core $memory $core-blend $core-blend))
          ($extensions (discover-extensions $memory $core-blend))
          ($candidate-1 $core-blend)
          ($candidate-2 (unique-atom (append $core-blend $extensions)))
          ($bonus-1 (habit-bonus $memory $candidate-1))
          ($bonus-2 (habit-bonus $memory $candidate-2))
          ($eval-title (println! (Evaluating Generated Options:)))
          ($eval-1 (println! (Candidate 1 Basic Core $candidate-1 Habit Bonus: $bonus-1)))
          ($eval-2 (println! (Candidate 2 Expanded $candidate-2 Habit Bonus: $bonus-2))))
      (candidate-result $candidate-1 $bonus-1 $candidate-2 $bonus-2)))
